# Copy this file to .env and fill in your real key.
# NEVER commit the real .env file to git.
#
# The Gemini API key is used ONLY by the Python backend.
# Do NOT put this key in the React frontend.

GEMINI_API_KEY=your_gemini_api_key_here

# Gemini embedding model used in Step 4 (text → vector).
# Official text embedding model: gemini-embedding-001
# Newer multimodal option: gemini-embedding-2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Gemini chat model used for RAG answers (Step 7).
# Prefer flash-lite on free tier (higher quota / fewer 429 errors).
# gemini-flash-latest maps to a heavier model with a low daily free limit.
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
